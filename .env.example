# ============================================
# Environment Configuration — Finance Dashboard
# Copy this file to .env and fill in values
# ============================================

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-change-me-in-production
JWT_EXPIRATION_MS=86400000

# H2 Database
H2_CONSOLE_ENABLED=true

# Server
SERVER_PORT=8080

# Admin seed credentials (used by DataInitializer)
ADMIN_EMAIL=admin@efinace.com
ADMIN_PASSWORD=Admin@123
